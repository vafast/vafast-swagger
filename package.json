{
  "name": "@vafast/swagger",
  "version": "0.0.9",
  "description": "Plugin for Vafast for Swagger/OpenAPI documentation",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "dev": "npx tsx watch example/index.ts",
    "test": "npx vitest run",
    "release": "npm run build && npm run test && npx bumpp && npm publish --access=public",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vafast": "<2.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rimraf": "^6.0.1",
    "tsdown": "^0.19.0-beta.4",
    "typescript": "^5.4.5",
    "vitest": "^4.0.16",
    "vafast": "^0.8.1"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "keywords": [
    "vafast",
    "swagger",
    "openapi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vafast/vafast-swagger"
  },
  "author": {
    "name": "saltyAom",
    "url": "https://github.com/SaltyAom",
    "email": "saltyaom@gmail.com"
  },
  "homepage": "https://github.com/vafast/vafast-swagger",
  "bugs": "https://github.com/vafast/vafast-swagger/issues"
}
